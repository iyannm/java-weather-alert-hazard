<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" styleClass="root" stylesheets="@/css/uog-theme.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.emailsender.gui.controllers.DashboardController">

    <!-- Header -->
    <HBox prefHeight="60" styleClass="header" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
        <Text styleClass="header-text" text="Dashboard" />
    </HBox>

    <!-- Body -->
    <VBox alignment="CENTER" layoutX="30.0" layoutY="14.0" spacing="100.0" AnchorPane.bottomAnchor="86.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="50.0" AnchorPane.topAnchor="14.0">

        <Text styleClass="title-text" text="Welcome to WAH Email Sender Dashboard" />

        <HBox alignment="CENTER" spacing="40">
            <Button fx:id="sendEmailButton" onAction="#handleSendEmail" prefHeight="117.0" prefWidth="246.0" styleClass="button button-primary" text="Send Email" />

            <Button fx:id="contactsButton" onAction="#handleContacts" prefHeight="118.0" prefWidth="279.0" styleClass="button button-secondary" text="Contacts" />
        </HBox>

    </VBox>

</AnchorPane>
