<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.emailsender.gui.controllers.ContactsController"

      spacing="10" padding="15">

    <Label text="Contacts" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <TableView fx:id="contactsTable" prefHeight="300">
        <columns>
            <TableColumn fx:id="nameColumn" text="Name" prefWidth="150"/>
            <TableColumn fx:id="emailColumn" text="Email" prefWidth="250"/>
        </columns>
    </TableView>

    <HBox spacing="10">
        <Button text="Create Contact" onAction="#onCreateContact"/>
        <Button text="Edit Contact" onAction="#onEditContact"/>
        <Button text="Delete Contact" onAction="#onDeleteContact"/>
    </HBox>
</VBox>
