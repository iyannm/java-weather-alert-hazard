<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.emailsender.gui.controllers.ContactsController"
      spacing="15"
      alignment="TOP_CENTER"
      styleClass="root-pane">

    <!-- Correct Padding -->
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Header Label -->
    <Label text="Contacts" styleClass="header-label-contact"/>

    <!-- TableView for contacts -->
    <TableView fx:id="contactsTable" prefHeight="400" prefWidth="760" styleClass="table-view">
        <columns>
            <TableColumn fx:id="nameColumn" text="Name" prefWidth="380"/>
            <TableColumn fx:id="emailColumn" text="Email" prefWidth="380"/>
        </columns>
    </TableView>

    <!-- Action buttons -->
    <HBox spacing="15" alignment="CENTER_RIGHT">
        <Button fx:id="btnBack" text="Back to Dashboard" styleClass="back-button"/>
        <Button text="Create Contact" onAction="#onCreateContact" styleClass="send-button"/>
        <Button text="Edit Contact" onAction="#onEditContact" styleClass="send-button"/>
        <Button text="Delete Contact" onAction="#onDeleteContact" styleClass="send-button"/>
    </HBox>


</VBox>
