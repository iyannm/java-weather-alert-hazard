<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" styleClass="root-pane" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.emailsender.gui.controllers.guiController">

   <!-- Header -->
   <Label layoutX="50.0" layoutY="20.0" prefHeight="60.0" prefWidth="700.0" styleClass="header-label" text="WAH EMAIL PROJECT" />

   <!-- Section Title -->
   <Label layoutX="50.0" layoutY="100.0" styleClass="section-label" text="New Email" />

   <!-- Contacts ComboBox -->
   <ComboBox fx:id="comboContacts" layoutX="50.0" layoutY="141.0" prefWidth="250.0" promptText="Select Contact" styleClass="input-field" />

   <!-- To Field -->
   <TextField fx:id="txtTo" layoutX="50.0" layoutY="202.0" prefWidth="700.0" promptText="To:" styleClass="input-field" />

   <!-- Subject Field -->
   <TextField fx:id="txtSubject" layoutX="50.0" layoutY="250.0" prefWidth="700.0" promptText="Subject" styleClass="input-field" />

   <!-- Body Field -->
   <TextArea fx:id="txtBody" layoutX="50.0" layoutY="300.0" prefHeight="220.0" prefWidth="700.0" promptText="Write your email here..." styleClass="text-area" />

   <!-- Send Button -->
   <Button fx:id="btnSend" layoutX="650.0" layoutY="539.0" prefHeight="40.0" prefWidth="100.0" styleClass="send-button" text="Send" />

</AnchorPane>
